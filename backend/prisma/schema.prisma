generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  VENDOR
}

enum WorkRequestStatus {
  DRAFT
  OPEN
  BOOKED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  RESPONDED
}

enum BidStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ESEWA
  KHALTI
  OTHER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  vendorId     String?  @unique @db.Uuid
  isActive     Boolean  @default(true)
  vendor       Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  workRequests WorkRequest[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vendor {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String
  contactPerson String
  email         String   @unique
  phone         String
  address       String?
  category      String?
  isActive      Boolean  @default(true)
  user          User?
  invitations   Invitation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkRequest {
  id            String            @id @default(uuid()) @db.Uuid
  title         String
  description   String
  eventDate     DateTime
  eventLocation String
  status        WorkRequestStatus @default(DRAFT)
  createdById   String            @db.Uuid
  createdBy     User              @relation(fields: [createdById], references: [id])
  items         RequestItem[]
  photos        RequestPhoto[]
  invitations   Invitation[]
  booking       Booking?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([createdById])
  @@index([status])
}

model RequestItem {
  id            String      @id @default(uuid()) @db.Uuid
  workRequestId String      @db.Uuid
  workRequest   WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  quantity      Int
  unit          String?
  createdAt     DateTime    @default(now())

  @@index([workRequestId])
}

model RequestPhoto {
  id            String      @id @default(uuid()) @db.Uuid
  workRequestId String      @db.Uuid
  workRequest   WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  imageUrl      String
  createdAt     DateTime    @default(now())

  @@index([workRequestId])
}

model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  workRequestId String           @db.Uuid
  vendorId      String           @db.Uuid
  status        InvitationStatus @default(PENDING)
  workRequest   WorkRequest      @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  bid           Bid?

  @@unique([workRequestId, vendorId])
  @@index([vendorId])
}

model Bid {
  id           String     @id @default(uuid()) @db.Uuid
  invitationId String     @unique @db.Uuid
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  notes        String?
  status       BidStatus  @default(SUBMITTED)
  submittedAt  DateTime   @default(now())
  booking      Booking?

  @@index([status])
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  reference     String        @unique @default(dbgenerated("('ME-BKG-'::text || lpad((nextval('booking_reference_seq'::regclass))::text, 6, '0'::text))"))
  workRequestId String        @unique @db.Uuid
  bidId         String        @unique @db.Uuid
  workRequest   WorkRequest   @relation(fields: [workRequestId], references: [id])
  bid           Bid           @relation(fields: [bidId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(CONFIRMED)
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  booking   Booking       @relation(fields: [bookingId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  notes     String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([bookingId])
}
